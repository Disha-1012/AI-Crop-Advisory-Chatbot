# ==========================================
# CropCare AI - Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Local configuration
*.local

# FastAPI / Uvicorn
*.log

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
frontend/dist/
frontend/.vite/

# Build files
dist/
build/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/

# Python test / coverage files
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp

# Local database files
*.db
*.sqlite
*.sqlite3